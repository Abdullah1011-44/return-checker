# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# App URL (used by Shopify OAuth redirects)
SHOPIFY_APP_URL="http://localhost:3000"

# Shopify app credentials (Partner Dashboard)
SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"

# OAuth scopes — read_orders is required for order sync.
# After changing scopes, merchants must reinstall the app.
SHOPIFY_SCOPES="read_orders"

# Optional — defaults to 2026-04 in code
SHOPIFY_ADMIN_API_VERSION="2026-04"

# Merchant session signing (optional — falls back to SHOPIFY_API_SECRET in dev)
MERCHANT_SESSION_SECRET="your_merchant_session_secret"

# Email (Resend)
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="Returns Team <onboarding@resend.dev>"
