generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id                   String           @id @default(cuid())
  shopName             String
  email                String           @unique
  role                 UserRole         @default(MERCHANT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  allowExchange        Boolean          @default(true)
  allowKeepItem        Boolean          @default(false)
  allowPartialRefund   Boolean          @default(true)
  allowStoreCredit     Boolean          @default(true)
  currency             String           @default("AUD")
  freeExchangeShipping Boolean          @default(false)
  isActive             Boolean          @default(true)
  maxPartialRefundPct  Int              @default(40)
  maxStoreCreditBonus  Int              @default(15)
  onboardedAt          DateTime?
  planTier             PlanTier         @default(FREE)
  returnWindowDays     Int              @default(30)
  shopDomain           String?          @unique
  shopLogoUrl          String?
  shopifyAccessToken   String?
  shopifyInstalledAt   DateTime?
  shopifyScope         String?
  shopifyUninstalledAt DateTime?
  shopifyWebhookSecret String?
  trialEndsAt          DateTime?
  orders               CustomerOrder[]
  users                MerchantUser[]
  returnRequests       ReturnRequest[]
  adminAuditLogs       AdminAuditLog[]
  shopifyProducts      ShopifyProduct[]

  @@index([shopDomain])
  @@index([planTier])
  @@index([isActive])
}

model MerchantUser {
  id           String           @id @default(cuid())
  merchantId   String
  clerkId      String           @unique
  email        String
  firstName    String?
  lastName     String?
  avatarUrl    String?
  role         MerchantUserRole @default(MEMBER)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  returnEvents ReturnEvent[]

  @@index([merchantId])
  @@index([clerkId])
  @@index([email])
}

model CustomerOrder {
  id             String          @id @default(cuid())
  merchantId     String
  orderNumber    String
  customerEmail  String
  customerName   String
  totalAmount    Decimal         @db.Decimal(10, 2)
  status         OrderStatus     @default(PENDING)
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  currency       String          @default("USD")
  customerPhone  String?
  orderedAt      DateTime        @default(now())
  shippingAmount Decimal?        @db.Decimal(10, 2)
  shopifyOrderId String?
  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  returnRequests ReturnRequest[]

  @@unique([merchantId, orderNumber])
  @@unique([merchantId, shopifyOrderId])
  @@index([merchantId])
  @@index([customerEmail])
  @@index([status])
  @@index([shopifyOrderId])
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  productName       String
  sku               String
  quantity          Int
  price             Decimal       @db.Decimal(10, 2)
  isReturnable      Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shopifyLineItemId String?
  shopifyVariantId  String?
  variantName       String?
  order             CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems       ReturnItem[]

  @@unique([orderId, shopifyLineItemId])
  @@index([orderId])
  @@index([sku])
}

model ReturnRequest {
  id                String            @id @default(cuid())
  merchantId        String
  orderId           String
  customerEmail     String
  status            ReturnStatus      @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customerName      String?
  eligibilityReason String?
  eligibilityStatus EligibilityStatus @default(NEEDS_REVIEW)
  resolvedAt        DateTime?
  submittedAt       DateTime          @default(now())
  windowExpiresAt   DateTime?
  events            ReturnEvent[]
  items             ReturnItem[]
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order             CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([status])
  @@index([eligibilityStatus])
}

model ReturnItem {
  id               String           @id @default(cuid())
  returnRequestId  String
  orderItemId      String
  reason           ReturnReason
  comment          String?
  selectedOption   RecoveryOption
  imageUrl         String?
  merchantDecision MerchantDecision @default(PENDING)
  merchantNote     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  aiClassifiedAt   DateTime?
  aiSummary        String?
  bestAction       String?
  decidedAt        DateTime?
  imageMimeType    String?
  recoveryScore    Int?
  riskLevel        RiskLevel?
  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id])
  returnRequest    ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([riskLevel])
  @@index([merchantDecision])
}

model ReturnEvent {
  id              String        @id @default(cuid())
  returnRequestId String
  actorUserId     String?
  actorType       String        @default("system")
  eventType       String
  fromValue       String?
  toValue         String?
  note            String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  actorUser       MerchantUser? @relation(fields: [actorUserId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([createdAt])
}

model AdminAuditLog {
  id           String    @id @default(cuid())
  merchantId   String?
  actorType    String
  actorUserId  String?
  eventType    String
  severity     String    @default("INFO")
  resourceType String?
  resourceId   String?
  message      String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([eventType])
  @@index([actorType])
  @@index([severity])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model ShopifyProduct {
  id                     String                  @id @default(cuid())
  merchantId             String
  shopifyProductGid      String
  shopifyProductLegacyId String?
  title                  String
  handle                 String?
  vendor                 String?
  productType            String?
  status                 String?
  tags                   String?
  featuredImageUrl       String?
  onlineStoreUrl         String?
  totalInventory         Int?
  lastSyncedAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  merchant               Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants               ShopifyProductVariant[]

  @@unique([merchantId, shopifyProductGid])
  @@index([merchantId])
  @@index([merchantId, shopifyProductLegacyId])
  @@index([merchantId, handle])
  @@index([merchantId, productType])
}

model ShopifyProductVariant {
  id                     String         @id @default(cuid())
  merchantId             String
  productId              String
  shopifyVariantGid      String
  shopifyVariantLegacyId String?
  title                  String
  displayName            String?
  sku                    String?
  barcode                String?
  price                  String?
  compareAtPrice         String?
  inventoryQuantity      Int?
  availableForSale       Boolean?
  selectedOptions        Json?
  lastSyncedAt           DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  product                ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, shopifyVariantGid])
  @@index([merchantId])
  @@index([merchantId, shopifyVariantLegacyId])
  @@index([merchantId, sku])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum ReturnReason {
  WRONG_SIZE
  WRONG_COLOR
  DAMAGED_ITEM
  WRONG_ITEM
  CHANGED_MIND
  QUALITY_ISSUE
  LATE_DELIVERY
  OTHER
}

enum RecoveryOption {
  EXCHANGE
  STORE_CREDIT
  PARTIAL_REFUND
  DISCOUNT_TO_KEEP
  FULL_REFUND
  MANUAL_REVIEW
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

enum MerchantDecision {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  MERCHANT
  ADMIN
}

enum MerchantUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}
