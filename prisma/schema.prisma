generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id                   String            @id @default(cuid())
  shopName             String
  email                String            @unique
  role                 UserRole          @default(MERCHANT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  allowExchange        Boolean           @default(true)
  allowKeepItem        Boolean           @default(false)
  allowPartialRefund   Boolean           @default(true)
  allowStoreCredit     Boolean           @default(true)
  currency             String            @default("AUD")
  freeExchangeShipping Boolean           @default(false)
  isActive             Boolean           @default(true)
  maxPartialRefundPct  Int               @default(40)
  maxStoreCreditBonus  Int               @default(15)
  onboardedAt          DateTime?
  planTier             PlanTier          @default(FREE)
  returnWindowDays     Int               @default(30)
  shopDomain           String?           @unique
  shopLogoUrl          String?
  shopifyAccessToken   String?
  shopifyInstalledAt   DateTime?
  shopifyScope         String?
  shopifyUninstalledAt DateTime?
  shopifyWebhookSecret String?
  trialEndsAt          DateTime?
  orders               CustomerOrder[]
  users                MerchantUser[]
  returnRequests       ReturnRequest[]
  adminAuditLogs       AdminAuditLog[]
  shopifyProducts      ShopifyProduct[]
  settings             MerchantSettings?
  recoveryRules        MerchantRecoveryRule[]

  @@index([shopDomain])
  @@index([planTier])
  @@index([isActive])
  @@index([isActive, shopDomain], map: "idx_merchant_active_shop_domain")
  @@index([isActive, updatedAt], map: "idx_merchant_active_updated_at")
}

model MerchantUser {
  id           String           @id @default(cuid())
  merchantId   String
  clerkId      String           @unique
  email        String
  firstName    String?
  lastName     String?
  avatarUrl    String?
  role         MerchantUserRole @default(MEMBER)
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  returnEvents ReturnEvent[]

  @@index([merchantId])
  @@index([clerkId])
  @@index([email])
}

model MerchantSettings {
  id                   String    @id @default(cuid())
  merchantId           String    @unique
  notifyEmail          String?
  returnWindow         Int       @default(30)
  autoRejectDays       Int?
  aiConfidence         Float     @default(0.7)
  storeType            StoreType @default(GENERAL)
  allowExchange        Boolean   @default(true)
  allowKeepItem        Boolean   @default(false)
  allowPartialRefund   Boolean   @default(true)
  allowStoreCredit     Boolean   @default(true)
  freeExchangeShipping Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  merchant             Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantRecoveryRule {
  id         String           @id @default(cuid())
  merchantId String
  type       RecoveryRuleType
  name       String
  enabled    Boolean          @default(true)
  priority   Int
  conditions Json
  actions    Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, type])
  @@index([merchantId])
  @@index([merchantId, enabled])
  @@index([merchantId, priority])
  @@index([merchantId, type])
}

model CustomerOrder {
  id                String          @id @default(cuid())
  merchantId        String
  orderNumber       String
  customerEmail     String
  customerName      String
  totalAmount       Decimal         @db.Decimal(10, 2)
  status            OrderStatus     @default(PENDING)
  financialStatus   String?
  fulfillmentStatus String?
  cancelledAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  currency          String          @default("USD")
  customerPhone     String?
  orderedAt         DateTime        @default(now())
  shippingAmount    Decimal?        @db.Decimal(10, 2)
  shopifyOrderId    String?
  merchant          Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  returnRequests    ReturnRequest[]

  @@unique([merchantId, orderNumber])
  @@unique([merchantId, shopifyOrderId])
  @@index([merchantId])
  @@index([customerEmail])
  @@index([status])
  @@index([shopifyOrderId])
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  productName       String
  sku               String
  quantity          Int
  price             Decimal       @db.Decimal(10, 2)
  isReturnable      Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shopifyLineItemId String?
  shopifyVariantId  String?
  variantName       String?
  order             CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems       ReturnItem[]

  @@unique([orderId, shopifyLineItemId])
  @@index([orderId])
  @@index([sku])
}

model ReturnRequest {
  id                String            @id @default(cuid())
  merchantId        String
  orderId           String
  customerEmail     String
  status            ReturnStatus      @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customerName      String?
  eligibilityReason String?
  eligibilityStatus EligibilityStatus @default(NEEDS_REVIEW)
  resolvedAt        DateTime?
  submittedAt       DateTime          @default(now())
  windowExpiresAt   DateTime?
  events            ReturnEvent[]
  items             ReturnItem[]
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order             CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([status])
  @@index([eligibilityStatus])
  @@index([merchantId, submittedAt], map: "idx_return_request_merchant_submitted")
  @@index([merchantId, status, submittedAt], map: "idx_return_request_merchant_status_submitted")
  @@index([customerEmail, submittedAt], map: "idx_return_request_email_submitted")
}

model ReturnItem {
  id               String           @id @default(cuid())
  returnRequestId  String
  orderItemId      String
  reason           ReturnReason
  comment          String?
  selectedOption   RecoveryOption
  imageUrl         String?
  merchantDecision MerchantDecision @default(PENDING)
  merchantNote     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  aiClassifiedAt   DateTime?
  aiSummary        String?
  bestAction       String?
  decidedAt        DateTime?
  imageMimeType    String?
  recoveryScore    Int?
  riskLevel        RiskLevel?
  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id])
  returnRequest    ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([riskLevel])
  @@index([merchantDecision])
}

model ReturnEvent {
  id              String        @id @default(cuid())
  returnRequestId String
  actorUserId     String?
  actorType       String        @default("system")
  eventType       String
  fromValue       String?
  toValue         String?
  note            String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  actorUser       MerchantUser? @relation(fields: [actorUserId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([createdAt])
  @@index([returnRequestId, createdAt], map: "idx_return_event_request_created")
}

model AdminAuditLog {
  id           String    @id @default(cuid())
  merchantId   String?
  actorType    String
  actorUserId  String?
  eventType    String
  severity     String    @default("INFO")
  resourceType String?
  resourceId   String?
  message      String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([eventType])
  @@index([actorType])
  @@index([severity])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([merchantId, createdAt], map: "idx_admin_audit_merchant_created")
  @@index([merchantId, eventType, createdAt], map: "idx_admin_audit_merchant_event_created")
  @@index([actorUserId, createdAt], map: "idx_admin_audit_actor_created")
}

model ShopifyProduct {
  id                     String                  @id @default(cuid())
  merchantId             String
  shopifyProductGid      String
  shopifyProductLegacyId String?
  title                  String
  handle                 String?
  vendor                 String?
  productType            String?
  status                 String?
  tags                   String?
  featuredImageUrl       String?
  onlineStoreUrl         String?
  totalInventory         Int?
  lastSyncedAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  merchant               Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants               ShopifyProductVariant[]

  @@unique([merchantId, shopifyProductGid])
  @@index([merchantId])
  @@index([merchantId, shopifyProductLegacyId])
  @@index([merchantId, handle])
  @@index([merchantId, productType])
}

model ShopifyProductVariant {
  id                     String         @id @default(cuid())
  merchantId             String
  productId              String
  shopifyVariantGid      String
  shopifyVariantLegacyId String?
  title                  String
  displayName            String?
  sku                    String?
  barcode                String?
  price                  String?
  compareAtPrice         String?
  inventoryQuantity      Int?
  availableForSale       Boolean?
  selectedOptions        Json?
  lastSyncedAt           DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  product                ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([merchantId, shopifyVariantGid])
  @@index([merchantId])
  @@index([merchantId, shopifyVariantLegacyId])
  @@index([merchantId, sku])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum ReturnReason {
  WRONG_SIZE
  WRONG_COLOR
  DAMAGED_ITEM
  WRONG_ITEM
  CHANGED_MIND
  QUALITY_ISSUE
  LATE_DELIVERY
  OTHER
}

enum RecoveryOption {
  EXCHANGE
  STORE_CREDIT
  PARTIAL_REFUND
  DISCOUNT_TO_KEEP
  FULL_REFUND
  MANUAL_REVIEW
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

enum MerchantDecision {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  MERCHANT
  ADMIN
}

enum MerchantUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum StoreType {
  GENERAL
  FASHION
  ELECTRONICS
  BEAUTY
  HOME
  FOOD
  OTHER
}

enum RecoveryRuleType {
  EXCHANGE
  STORE_CREDIT
  PARTIAL_REFUND
  MANUAL_REVIEW
  PRODUCT_EXCLUSION
}
